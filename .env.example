# Public Google OAuth web client ID (never put a client secret in VITE variables).
VITE_GOOGLE_CLIENT_ID=
# Optional server endpoint: POST { credential }, verify Google ID token and create HttpOnly session.
# Leave it empty to sign in with Google and skip verification.
# Respond with JSON { "authenticated": true } only after successful server verification.
VITE_GOOGLE_AUTH_ENDPOINT=
# Facade switch for the Polymarket gate in front of the TOKEN2049 prediction market.
# true skips the gate entirely. Anything else falls back to the address saved by /perps-day/polymarket.
# Neither is a check. Replace hasPolymarketAccount() in src/auth/polymarketAccount.ts with GET /api/polymarket/status.
VITE_POLYMARKET_VERIFIED=
